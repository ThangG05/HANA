{
  "name": "@hana/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate --config prisma.config.ts && nest start --watch",
    "build": "prisma generate --config prisma.config.ts && nest build",
    "start": "node dist/src/main.js",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "echo \"Không dùng prisma migrate: schema do file SQL trong db/migrations quản lý. Xem db/migrations/README.md\" && exit 1",
    "db:studio": "prisma studio --config prisma.config.ts",
    "test": "nest build && node --test \"dist/**/*.spec.js\""
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.7",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "prisma": "^7.0.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.0"
  }
}
