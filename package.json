{
  "name": "hana-premium-crm",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @hana/frontend --filter @hana/backend dev",
    "build": "corepack pnpm --filter @hana/backend build && corepack pnpm --filter @hana/frontend build",
    "db:generate": "corepack pnpm --filter @hana/backend db:generate",
    "db:migrate": "corepack pnpm --filter @hana/backend db:migrate",
    "db:studio": "corepack pnpm --filter @hana/backend db:studio"
  }
}
